ARG BASE_IMAGE=robowheels:control-humble
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-c"]
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    curl ca-certificates mesa-utils x11-utils build-essential cmake qtbase5-dev \
    ros-humble-rviz-common ros-humble-pluginlib ros-humble-diff-drive-controller \
    && rm -rf /var/lib/apt/lists/*
RUN if test -x /opt/VirtualGL/bin/vglrun && dpkg-query -W -f='${Version}' virtualgl | grep -q '^3.1.5-'; then \
      echo "Using installed VirtualGL 3.1.5"; \
    else arch="$(dpkg --print-architecture)" && case "$arch" in \
      arm64) digest=9ac238e8a18c06d84ef65444a591a7a5bb4c4ce9e8cfdd92f8a2aea35edbb5d7 ;; \
      amd64) digest=df3f7788ce41b182a47c0d298e5cd6d2d63579522cb41825970b7726e825485e ;; \
      *) exit 1 ;; esac \
    && curl -fL --retry 3 --retry-all-errors "https://github.com/VirtualGL/virtualgl/releases/download/3.1.5/virtualgl_3.1.5_${arch}.deb" -o /tmp/virtualgl.deb \
    && echo "$digest  /tmp/virtualgl.deb" | sha256sum -c - \
    && apt-get update && apt-get install -y --no-install-recommends /tmp/virtualgl.deb \
    && rm /tmp/virtualgl.deb && rm -rf /var/lib/apt/lists/*; fi
COPY ros2_ws/src/robowheels_rviz_plugins /ws/src/robowheels_rviz_plugins
COPY ros2_ws/src/robowheels_description /ws/src/robowheels_description
COPY ros2_ws/src/robowheels_sim /ws/src/robowheels_sim
RUN source /opt/ros/humble/setup.bash && source /ws/install/setup.bash \
    && colcon build --symlink-install --packages-select robowheels_description robowheels_rviz_plugins robowheels_sim
COPY docker/sim/control-entrypoint.sh /control-entrypoint.sh
ENV ROBOWHEELS_DISPLAY_MODE=xquartz QT_X11_NO_MITSHM=1
