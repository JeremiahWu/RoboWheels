ARG BASE_IMAGE=robowheels:sim-humble
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-c"]
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    ros-humble-rviz2 ros-humble-ros2-control ros-humble-joint-trajectory-controller \
    ros-humble-joint-state-broadcaster ros-humble-diff-drive-controller xvfb x11vnc novnc websockify openbox \
    && rm -rf /var/lib/apt/lists/*
COPY ros2_ws/src/robowheels_description /ws/src/robowheels_description
COPY ros2_ws/src/robowheels_sim /ws/src/robowheels_sim
RUN source /opt/ros/humble/setup.bash && colcon build --symlink-install
COPY docker/sim/control-entrypoint.sh /control-entrypoint.sh
ENV DISPLAY=:1 LIBGL_ALWAYS_SOFTWARE=1 QT_X11_NO_MITSHM=1
ENTRYPOINT ["/bin/bash", "/control-entrypoint.sh"]
