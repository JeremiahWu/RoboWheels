# third-party drivers with their own git history (keep out of this repo)
drivers/

# macOS / editor temporary files
.DS_Store
._*
.AppleDouble/
*~
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej
.idea/

# Local configuration / secrets (keep shareable examples)
.env
.env.*
!.env.example
!.env.*.example
compose.override.yaml
compose.override.yml
.local/
# X11 authentication must stay local, including manually copied files.
.Xauthority
Xauthority

# Raw CAD stays local; exported runtime meshes and URDF/SDF are versioned.
/models/
/step/*
!/step/README.md
solver.bin

# colcon build artifacts
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
ros2_ws/**/CMakeFiles/
ros2_ws/**/CMakeCache.txt
ros2_ws/**/compile_commands.json
ros2_ws/**/*.o
ros2_ws/**/*.so

# python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/

# uv
.venv/
.venv-*/
uv.lock.hash

# Runtime recordings / logs; do not ignore source config or robot meshes.
*.log
*.bag
*.db3
*.db3-shm
*.db3-wal
*.mcap
rosbags/

# ROS runtime state and crash dumps
.ros/
core
core.[0-9]*
vgcore.*

# Local runtime handles, temporary exports and timestamped ROS recordings
*.pid
*.pid.lock
*.sock
/.uv/
/tmp/
/rosbag2_*/
