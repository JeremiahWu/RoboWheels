Panels:
  - Class: robowheels_rviz_plugins/ControlPanel
    Name: RoboWheels Control
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 38; 47; 59
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Path
      Name: Base trajectory
      Enabled: true
      Topic:
        Value: /base_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color: 80; 210; 170
      Line Style: Lines
      Line Width: 0.01
      Buffer Length: 1
    - Class: rviz_default_plugins/Grid
      Name: Ground
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 30
      Color: 100; 119; 136
    - Class: rviz_default_plugins/RobotModel
      Name: RoboWheels
      Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: Joint frames
      Enabled: false
      Show Axes: true
      Show Arrows: false
      Show Names: true
      Marker Scale: 0.15
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_footprint
      Distance: 1.5
      Focal Point: {X: 0.0, Y: 0.0, Z: 0.3}
      Pitch: 0.35
      Yaw: 0.8
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1400
  Height: 900
  X: 0
  Y: 0
