Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 250
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
      camera_link:
        Value: true
      cam0:
        Value: true
      cam1:
        Value: true
      imu0:
        Value: true
    Marker Scale: 1
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree:
      camera_link: {}
      cam0:
        imu0: {}
      cam1:
        imu0: {}
    Update Interval: 0
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: Stereo point cloud (SGBM)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.01
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /stereo/points
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: Stereo depth (SGBM)
    Normalize Range: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /rdk_debug/depth/upright
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: Stereo left and right - upright
    Normalize Range: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /rdk_debug/stereo/upright
    Value: true
  - Class: rviz_default_plugins/Marker
    Name: IMU acceleration and readings
    Enabled: true
    Topic:
      Value: /rdk_debug/imu
      Reliability Policy: Reliable
      Depth: 10
    Value: true
  - Class: rviz_default_plugins/Marker
    Name: Encoder ticks A and B
    Enabled: true
    Topic:
      Value: /rdk_debug/encoders
      Reliability Policy: Reliable
      Depth: 10
    Value: true
  Enabled: true
  - Class: rviz_default_plugins/Map
    Name: Local obstacle grid
    Enabled: true
    Alpha: 0.65
    Topic:
      Value: /perception/local_grid
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 1
    Color Scheme: map
    Draw Behind: false
  - Class: rviz_default_plugins/Path
    Name: ESDF planning preview
    Enabled: true
    Topic:
      Value: /planning/path
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 1
    Color: 255; 170; 0
    Line Style: Lines
    Line Width: 0.03
  - Class: rviz_default_plugins/Path
    Name: ORB visual odometry
    Enabled: true
    Topic:
      Value: /localization/vo_path
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 1
    Color: 0; 255; 180
    Line Style: Lines
    Line Width: 0.02
  - Class: rviz_default_plugins/Image
    Name: ORB features
    Enabled: true
    Topic:
      Value: /perception/orb_features
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 1
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_link
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Yaw: 3.0
    Saved: null
Window Geometry:
  Height: 1000
  Width: 1600
  X: 0
  Y: 0

